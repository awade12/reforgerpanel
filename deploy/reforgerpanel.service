[Unit]
Description=Reforger Panel Web UI
After=network-online.target postgresql.service reforgerpanel-agent.service
Wants=network-online.target reforgerpanel-agent.service
StartLimitIntervalSec=300

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/reforgerpanel
EnvironmentFile=/etc/reforgerpanel/env
Environment=NODE_ENV=production
ExecStartPre=/bin/bash -c 'test -f .next/BUILD_ID || { echo "Missing production build — run: cd /opt/reforgerpanel && npm run build"; exit 1; }'
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
