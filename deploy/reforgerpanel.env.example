ADMIN_PASSWORD=admin
AGENT_TOKEN=change-me-agent-token
SESSION_SECRET=change-me-session-secret
SECRETS_ENCRYPTION_KEY=change-me-secrets-key
AGENT_URL=http://127.0.0.1:9100
AGENT_HOST=127.0.0.1
AGENT_PORT=9100
REFORGER_ROOT=/opt/reforger
REFORGER_USER=ubuntu
STEAMCMD_PATH=/opt/reforger/steamcmd/steamcmd.sh
PANEL_DATA_DIR=/opt/reforger/panel-data
PANEL_ROOT=/opt/reforgerpanel
PORT=3000
# Production (install-vps.sh): localhost only — Caddy serves HTTPS publicly
HOSTNAME=127.0.0.1

# PostgreSQL (required for production)
# Local dev: npm run db:up
# Server:    sudo bash scripts/setup-postgres.sh
# DATABASE_URL=postgresql://reforgerpanel:reforgerpanel@127.0.0.1:5432/reforgerpanel

# Discord bot: configure token and client ID in the panel (Discord page), not here.
PANEL_PUBLIC_URL=https://panel.example.com
COOKIE_SECURE=true
PANEL_PUBLIC_HOST=panel.example.com
# CADDY_ADMIN_EMAIL=admin@example.com
