[Unit]
Description=Reforger Host Discord Bot
After=network-online.target reforgerpanel-agent.service
Wants=reforgerpanel-agent.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/reforgerpanel
EnvironmentFile=/etc/reforgerpanel/env
ExecStart=/usr/bin/npm run bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
