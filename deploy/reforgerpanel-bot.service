[Unit]
Description=Reforger Panel Discord Bot
After=network.target reforgerpanel-agent.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/reforgerpanel
EnvironmentFile=/etc/reforgerpanel/env
ExecStart=/usr/bin/npm run bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
