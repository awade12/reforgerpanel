{
  "name": "reforgerpanel",
  "version": "0.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/awade12/reforgerpanel.git"
  },
  "homepage": "https://github.com/awade12/reforgerpanel#readme",
  "bugs": {
    "url": "https://github.com/awade12/reforgerpanel/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh -c 'npm run agent & npm run dev'",
    "dev:agent": "tsx agent/index.ts",
    "agent": "tsx agent/index.ts",
    "bot": "tsx src/bot/index.ts",
    "dev:bot": "tsx src/bot/index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate-to-postgres.ts",
    "db:setup": "sudo bash scripts/setup-postgres.sh",
    "install:vps": "sudo bash scripts/install-vps.sh",
    "rehearse:install": "sudo bash scripts/rehearse-install.sh",
    "check:install": "sudo bash scripts/check-install.sh",
    "smoke": "tsx scripts/smoke-test.ts",
    "test": "node --import tsx --test lib/shared/*.test.ts",
    "secrets:rotate": "tsx scripts/rotate-secrets.ts",
    "build": "next build",
    "start": "sh -c 'next start -H \"${HOSTNAME:-0.0.0.0}\" -p \"${PORT:-3000}\"'",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "discord.js": "^14.26.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  }
}
